# Required for clients of the CourtListener Python library and for the MCP
# server in stdio mode.
COURTLISTENER_API_TOKEN=

# Optional: point the library/MCP server at a non-production CourtListener
# instance (e.g., a local dev server). Leave unset to use the public API.
# COURTLISTENER_API_BASE_URL=http://host.docker.internal:8000/api/rest/v4

# Required for the HTTP MCP server. The Docker Compose dev stack wires this
# automatically; set it explicitly if running the app outside Compose.
# REDIS_URL=redis://localhost:6379

# Postgres for the MCP server's OAuth token store. Production only: the
# Compose dev stack hardcodes its own values.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=mcp
# PGPASSWORD=mcp
# PGDATABASE=mcp

# The MCP server's own OAuth application at CourtListener: a confidential
# application whose redirect URI is <MCP_BASE_URL>/auth/callback. Required for
# the HTTP MCP server, which signs users in through it.
# COURTLISTENER_OAUTH_CLIENT_ID=
# COURTLISTENER_OAUTH_CLIENT_SECRET=

# Optional: the scopes and RFC 8707 resources the MCP server requests from
# CourtListener on the user's behalf. Defaults to "openid api wiki email" and
# "<COURTLISTENER_API_BASE_URL>/ https://wiki.free.law".
# COURTLISTENER_OAUTH_SCOPES=
# COURTLISTENER_OAUTH_RESOURCES=

# Secrets for the OAuth token store: a Fernet key (32 url-safe base64 bytes)
# that encrypts the stored CourtListener tokens, and the key that signs the
# access tokens the MCP server issues. Both are derived from MCP_SECRET_KEY
# when unset, which is fine for development only.
# MCP_STORAGE_ENCRYPTION_KEY=
# MCP_JWT_SIGNING_KEY=

# HMAC key used to derive per-user cache prefixes in Redis for session-scoped
# tool state (query pagination, citation analysis jobs). Set to a strong
# random value in production.
# MCP_SECRET_KEY=

# Optional: Sentry DSN for error reporting from the HTTP MCP server. Leave
# unset to disable Sentry (sentry_sdk.init() with dsn=None is a no-op).
# SENTRY_DSN=
